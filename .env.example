# === Database ===
# Local Docker:
# DATABASE_URL="postgresql://pm:pmsecret@localhost:5432/pmtool?schema=public"
#
# Supabase (recommended for Vercel):
# 1. Create a project at https://supabase.com/dashboard
# 2. Settings → Database → Connection string (URI) — use the "Transaction" or "Session" pooler for serverless
# 3. Paste below (replace [YOUR-PASSWORD] and project ref)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (for migrations / prisma db push from local):
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# === Auth.js ===
NEXTAUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
# On Vercel set NEXTAUTH_URL to your production URL

# === Optional Supabase client (Realtime / Storage later) ===
# NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
